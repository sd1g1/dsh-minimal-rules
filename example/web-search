#!/usr/bin/env python3
"""Exa-powered network search CLI.

Canonical reference: https://docs.exa.ai/reference/search-api-guide-for-coding-agents
If this script's behavior looks outdated, check that URL for search types,
parameters, and response shape.
"""

from __future__ import annotations

import argparse
import json
import sys
import urllib.error
import urllib.request
from pathlib import Path

API_URL = "https://api.exa.ai/search"
DEFAULT_NUM_RESULTS = 10
SEARCH_TYPES = ("auto", "fast", "instant", "deep-lite", "deep", "deep-reasoning")


def load_api_key() -> str | None:
    """Return EXA_API_KEY from $HOME/.config/zsh/env.zsh."""
    path = Path.home() / ".config" / "zsh" / "env.zsh"
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return None

    for raw_line in lines:
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        # Accept both `export EXA_API_KEY=...` and `EXA_API_KEY=...`
        if line.startswith("export "):
            line = line[len("export "):].lstrip()
        if not line.startswith("EXA_API_KEY="):
            continue
        value = line.split("=", 1)[1].strip()
        value = value.strip().strip('"').strip("'")
        # Strip trailing shell comment if any
        if " #" in value:
            value = value.split(" #", 1)[0].strip()
        if value:
            return value
    return None


def parse_csv(value: str) -> list[str] | None:
    if not value:
        return None
    return [item.strip() for item in value.split(",") if item.strip()]


def build_payload(args: argparse.Namespace) -> dict:
    contents: dict | None = None
    if args.text:
        contents = {"text": {"maxCharacters": args.max_characters}}
    elif args.summary:
        contents = {"summary": True}
    elif not args.no_contents:
        contents = {"highlights": True}

    payload: dict = {
        "query": args.query,
        "type": args.type,
        "numResults": args.num_results,
    }
    if args.max_age_hours is not None:
        if contents is None:
            contents = {}
        contents["maxAgeHours"] = args.max_age_hours
    if contents is not None:
        payload["contents"] = contents
    include_domains = parse_csv(args.include_domains)
    if include_domains:
        payload["includeDomains"] = include_domains
    exclude_domains = parse_csv(args.exclude_domains)
    if exclude_domains:
        payload["excludeDomains"] = exclude_domains
    if args.system_prompt:
        payload["systemPrompt"] = args.system_prompt
    if args.output_schema:
        try:
            payload["outputSchema"] = json.loads(args.output_schema)
        except json.JSONDecodeError as exc:
            raise argparse.ArgumentTypeError(
                f"--output-schema must be valid JSON: {exc}"
            ) from exc
    return payload


def print_results(data: dict, args: argparse.Namespace) -> None:
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return

    output = data.get("output")
    if output is not None:
        print("=== Synthesized Output ===")
        content = output.get("content")
        if isinstance(content, str):
            print(content)
        else:
            print(json.dumps(content, ensure_ascii=False, indent=2))
        grounding = output.get("grounding")
        if grounding:
            print("\n=== Grounding ===")
            for item in grounding:
                field = item.get("field", "")
                confidence = item.get("confidence", "")
                urls = [c.get("url", "") for c in item.get("citations", [])]
                print(f"- {field} ({confidence}): {', '.join(urls)}")
        print()

    results = data.get("results") or []
    if not results:
        print("No results.")
        return

    for index, result in enumerate(results, start=1):
        title = result.get("title") or "(no title)"
        url = result.get("url", "")
        print(f"[{index}] {title}")
        if url:
            print(f"    URL: {url}")
        published = result.get("publishedDate")
        if published:
            print(f"    Published: {published}")
        highlights = result.get("highlights") or []
        if highlights:
            print("    Highlights:")
            for highlight in highlights[:3]:
                text = highlight.replace("\n", " ").strip()
                if text:
                    print(f"      - {text}")
        text_content = result.get("text")
        if text_content:
            print("    Text:")
            print(text_content)
        summary = result.get("summary")
        if summary:
            if isinstance(summary, str):
                print(f"    Summary: {summary}")
            else:
                print(f"    Summary: {json.dumps(summary, ensure_ascii=False)}")
        print()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Search the web with Exa (default: auto search + highlights)."
    )
    parser.add_argument("query", help="Search query")
    parser.add_argument(
        "-n",
        "--num-results",
        type=int,
        default=DEFAULT_NUM_RESULTS,
        help=f"Number of results to return (default: {DEFAULT_NUM_RESULTS})",
    )
    parser.add_argument(
        "-t",
        "--type",
        choices=SEARCH_TYPES,
        default="auto",
        help="Exa search type (default: auto)",
    )
    content_group = parser.add_mutually_exclusive_group()
    content_group.add_argument(
        "--text",
        action="store_true",
        help="Request full page text instead of highlights",
    )
    content_group.add_argument(
        "--summary",
        action="store_true",
        help="Request per-result summaries instead of highlights",
    )
    content_group.add_argument(
        "--no-contents",
        action="store_true",
        help="Do not request any content; return URLs/metadata only",
    )
    parser.add_argument(
        "--max-characters",
        type=int,
        default=20000,
        help="Max characters when --text is used (default: 20000)",
    )
    parser.add_argument(
        "--max-age-hours",
        type=int,
        help="Max cached content age in hours; 0 forces livecrawl, -1 cache only",
    )
    parser.add_argument(
        "--include-domains",
        help="Comma-separated domains to include, e.g. arxiv.org,github.com",
    )
    parser.add_argument(
        "--exclude-domains",
        help="Comma-separated domains to exclude, e.g. pinterest.com",
    )
    parser.add_argument(
        "--system-prompt",
        help="System prompt for synthesized/structured output",
    )
    parser.add_argument(
        "--output-schema",
        help="JSON schema for grounded structured output",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Print the raw JSON response",
    )
    args = parser.parse_args(argv)

    api_key = load_api_key()
    if not api_key:
        print(
            "Error: EXA_API_KEY not found in $HOME/.config/zsh/env.zsh.\n"
            'Add a line like: export EXA_API_KEY="YOUR_API_KEY"',
            file=sys.stderr,
        )
        return 2

    try:
        payload = build_payload(args)
    except argparse.ArgumentTypeError as exc:
        parser.error(str(exc))
        return 2

    request = urllib.request.Request(
        API_URL,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "Accept": "application/json",
            "User-Agent": "personal-tools-web-search/0.1",
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            data = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        print(f"Exa API error {exc.code}: {body}", file=sys.stderr)
        return 1
    except urllib.error.URLError as exc:
        print(f"Network error: {exc.reason}", file=sys.stderr)
        return 1
    except json.JSONDecodeError as exc:
        print(f"Invalid JSON from Exa API: {exc}", file=sys.stderr)
        return 1

    if isinstance(data, dict) and data.get("error"):
        print(f"Exa API error: {data['error']}", file=sys.stderr)
        return 1

    print_results(data, args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
